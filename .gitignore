# Dependencies
node_modules/

# Build output
.next/
# Folder build khusus E2E (lihat next.config.mjs + playwright.config.ts):
# memisahkan build produksi milik test dari `.next` milik `next dev`.
.next-e2e/
out/
build/

# Environment — JANGAN pernah di-commit: berisi AUTH_SECRET dan kredensial DB.
.env
.env.local
.env*.local

# Database lokal. dev.db adalah data pengembangan hasil seed; bisa
# dibangun ulang dengan `npm run db:migrate && npm run db:seed`.
prisma/dev.db
prisma/dev.db-journal
*.db
*.db-journal

# Artefak Playwright — laporan dan trace kegagalan, hanya berguna lokal.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Artefak kegagalan perbandingan visual kartu OG (lihat
# tests/helpers/og-card-visual.ts). Baseline-nya sendiri —
# tests/baselines/*.png — justru wajib di-commit.
/tests/baselines/__actual__/

# Log
npm-debug.log*
yarn-error.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Berkas kerja sementara
*.bak
image.png
postgress/
tsconfig.tsbuildinfo
.vercel
.env*
# ...tapi templatnya wajib tetap bisa di-commit: pola `.env*` di atas ikut
# mengenai `.env.example`, jadi pengecualian ini bukan hiasan.
!.env.example

# Build Android (keystore sengaja di-commit: tanda tangan stabil lintas CI)
android-webview/**/build/
android-webview/.gradle/
android-webview/local.properties
