{
  "name": "jasakite",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    ">0.3%",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "build:e2e": "NEXT_DIST_DIR=.next-e2e NODE_ENV=production next build",
    "start:e2e": "NEXT_DIST_DIR=.next-e2e next start",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-preflight.js && prisma generate && NODE_ENV=production next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:branding-dns": "BRAND_DNS=1 vitest run tests/branding.test.ts",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:backfill-city": "node prisma/backfill-city.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.70.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.24",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^5.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "vercel": "^59.10.0",
    "vitest": "^2.1.9"
  }
}
