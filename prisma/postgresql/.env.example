[TEMPLATE]
; .env.example untuk PostgreSQL
; ============================================================================
; Salin ke .env dan sesuaikan dengan kredensial PostgreSQL Anda.
;
; cp prisma/postgresql/.env.example .env
; ============================================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jasakite"

# Untuk connection pooling (production, via PgBouncer):
# DATABASE_URL="postgresql://postgres:postgres@localhost:6432/jasakite?pgbouncer=true"

# Untuk managed PostgreSQL (Neon, Supabase, Railway, dll):
# DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/jasakite?sslmode=require"

# Untuk Vercel + Neon (serverless):
# DATABASE_URL="postgres://user:pass@ep-xxx.region.aws.neon.tech/jasakite?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/jasakite"
