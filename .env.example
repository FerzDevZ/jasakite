[TEMPLATE]
# Salin ke .env lalu isi nilainya. JANGAN commit .env — berisi rahasia.

# Database — MongoDB. `prisma/schema.prisma` memakai provider = "mongodb", jadi
# SQLite (file:...) dan PostgreSQL tidak didukung; `scripts/vercel-preflight.js`
# menolak keduanya saat build daripada menebak.
#
# Lokal: mongod sendiri.
DATABASE_URL="mongodb://127.0.0.1:27017/jasakite"
# Atlas (prod, dan juga saat build Vercel):
# DATABASE_URL="mongodb+srv://<db_username>:<password>@ferz.bj80suv.mongodb.net/jasakite?retryWrites=true&w=majority&maxPoolSize=10"
#
# Untuk Atlas di Vercel:
# - Network Access wajib mengizinkan IP function Vercel (egress dinamis -> 0.0.0.0/0,
#   atau Static IP/Secure Compute milik Vercel). Build juga konek ke database
#   (sitemap.xml di-prerender), jadi allowlist yang sama berlaku saat build.
# - maxPoolSize: default driver 100 koneksi per instance; di serverless banyak
#   instance bisa menumbuk batas koneksi Atlas. Setel sesuai tier cluster.
# - retryWrites=true: menutup kegagalan tulis transien saat failover Atlas.

# Kunci penandatangan JWT. Hasilkan dengan: openssl rand -base64 32
#
# WAJIB diganti sebelum produksi. Kunci yang memuat nama proyek + kata
# "change-me" adalah kunci pengembangan yang bisa ditebak siapa pun: siapa yang
# tahu polanya bisa menempa cookie sesi sendiri, termasuk sesi ADMIN.
# Menggantinya mengeluarkan SEMUA sesi yang sedang aktif — lakukan saat trafik
# sepi, dan salin nilai baru ke environment Vercel pada saat yang sama.
AUTH_SECRET=""

# Auth.js v5 membaca AUTH_SECRET. NEXTAUTH_SECRET hanya alias lama; cukup isi
# salah satu, bukan keduanya.
# NEXTAUTH_SECRET=""

# NextAuth v5 beta menolak start tanpa ini.
AUTH_TRUST_HOST=true

# URL callback auth. Di produksi WAJIB domain https yang sebenarnya: kalau
# tertinggal localhost, callback login mengarah ke mesin pengguna sendiri.
NEXTAUTH_URL="http://localhost:3000"

# URL kanonik publik — dipakai metadata, Open Graph, JSON-LD, sitemap, robots.txt.
# WAJIB diisi di produksi; tanpa ini semua metadata menunjuk localhost.
# Jangan pakai VERCEL_URL: nilainya berubah setiap deployment preview.
#
# Domain ini juga dipakai di JSON-LD dan email kontak. Pastikan DNS-nya sudah
# aktif sebelum deploy: URL kanonik yang tidak bisa di-resolve membuat crawler
# gagal mengambil halaman sekaligus menggagalkan verifikasi kepemilikan domain.
# NEXT_PUBLIC_SITE_URL="https://jasakite.id"
# PLATFORM_BANK_NAME="BCA"
# PLATFORM_BANK_ACCOUNT_NUMBER="1234567890"
# PLATFORM_BANK_ACCOUNT_NAME="PT JASAKITE NUSANTARA"
